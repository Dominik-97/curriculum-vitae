# Hostinger VPS Configuration
# Copy this to your VPS alongside docker-compose.hostinger.yml

# Domain configuration (REQUIRED)
# Set SUBDOMAIN and TRAEFIK_HOST to match your domain
# Example: SUBDOMAIN=cv, TRAEFIK_HOST=example.com -> cv.example.com
SUBDOMAIN=cv
TRAEFIK_HOST=yourdomain.com

# Timezone
TZ=UTC
