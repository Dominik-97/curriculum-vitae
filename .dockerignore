# Dependencies (will be reinstalled)
node_modules/

# Build outputs (will be regenerated)
dist/
build/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Docker files
Dockerfile
docker-compose*.yml
.dockerignore

# Deployment scripts
deploy/
*.sh

# TeX source directory (not needed for React build)
tex-source/

# LaTeX build artifacts (from .gitignore)
*.aux
*.log
*.toc
*.bbl
*.blg
*.out
*.synctex*
*.fdb_latexmk
latex.out/
*.idx
*.ind
*.ilg
*.dvi
*.xdv
*.fls

# Exclude PDFs from tex-source (keep other PDFs for React bundling)
tex-source/*.pdf
