# Copy this file to `.env.local` (git-ignored) and fill in your values.
# Both variables must be set for analytics to load; leave them empty to disable
# tracking entirely (nothing is injected into the page).

# Umami analytics — self-hosted (chosen over Plausible: a single DB + small Node
# app is much lighter on a VPS than Plausible's Postgres + ClickHouse).

# Full URL to your Umami tracker script, e.g. https://umami.example.com/script.js
VITE_UMAMI_SRC=

# The website ID from Umami: Settings -> Websites -> (your site) -> Edit.
VITE_UMAMI_WEBSITE_ID=
